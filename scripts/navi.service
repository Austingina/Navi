[Unit]
Description=Robot Navigation Service
After=network-online.target 
Requires=network-online.target

[Service]
Type=oneshot
ExecStart=/home/nvidia/work/Navi/scripts/start_navi.sh
ExecStop=/home/nvidia/work/Navi/scripts/stop_navi.sh
User=nvidia
WorkingDirectory=/home/nvidia/work/Navi/scripts
Environment=HOME=/home/nvidia
Environment=USER=nvidia
Environment=XDG_RUNTIME_DIR=/run/user/1000
RemainAfterExit=yes
Restart=no

[Install]
WantedBy=multi-user.target
