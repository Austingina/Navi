
<!--
  Final-approach tree for campus_nav: same replanning/recovery structure as the
  stock navigate_to_pose tree, but FollowPath runs the tighter
  precise_goal_checker so the route end is not declared reached a metre out.
  Unlike the navigate_through_poses tree there is no RemovePassedGoals here,
  so the goal survives until the controller actually reaches it.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="2.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <Fallback>
              <ReactiveSequence>
                <Inverter>
                  <PathExpiringTimer seconds="3" path="{path}"/>
                </Inverter>
                <Inverter>
                  <GlobalUpdatedGoal/>
                </Inverter>
                <IsPathValid path="{path}"/>
              </ReactiveSequence>
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            </Fallback>
            <!-- Clearing the costmap is followed by a settle Wait on purpose: without it
                 the very next tick plans through a map that has just been emptied, i.e.
                 straight through the obstacle that caused the failure. The Sequence stays
                 RUNNING for the whole Wait, so RecoveryNode cannot retry planning yet.
                 With terrain_layer.clear_elevation_on_reset=False the elevation map
                 survives, so /terrain_cost_cloud refills the costmap in ~0.2 s and 2 s is
                 already generous. -->
            <Sequence name="ClearGlobalThenSettle">
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
              <Wait wait_duration="2"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="precise_goal_checker"/>
          <!-- Same reason as ClearGlobalThenSettle above. This branch fires on every DWB
               hiccup (controller_server.failure_tolerance = 0.3 s), so keep the Wait short
               or the robot stutters; 2 s is enough for both the terrain chain (5 Hz) and
               the scan chain (~10 Hz, accumulate_time 0.8 s) to repopulate. -->
          <Sequence name="ClearLocalThenSettle">
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
            <Wait wait_duration="2"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            <!-- Longer settle than the two Context branches: this is the last-resort clear,
                 reached only when BackUp / Spin / Wait all failed, so the map is likely
                 genuinely confused and worth a full rebuild before moving again. -->
            <Wait wait_duration="3"/>
          </Sequence>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="3"/>
          <BackUp backup_dist="0.30" backup_speed="0.1"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
