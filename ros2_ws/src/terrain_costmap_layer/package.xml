<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>terrain_costmap_layer</name>
  <version>0.1.0</version>
  <description>
    Persistent, graded terrain (slope) cost layer for nav2 costmap_2d.
    Consumes a per-cell terrain cost PointCloud2 and writes graded cost /
    LETHAL into its own rolling grid, accumulating over the rolling window
    (like ObstacleLayer) so terrain cost persists as the robot moves.
  </description>
  <maintainer email="dev@navi.local">navi</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_costmap_2d plugin="${prefix}/terrain_layer_plugins.xml" />
  </export>
</package>
