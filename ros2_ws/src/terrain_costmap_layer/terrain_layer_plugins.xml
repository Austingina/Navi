<!-- Layers here must derive from nav2_costmap_2d::Layer/CostmapLayer (which live in
     libnav2_costmap_2d_core.so), never from a built-in layer such as ObstacleLayer:
     those live in liblayers.so, which is itself a pluginlib library. Linking it as a
     plain dependency makes it load implicitly, so its factories get attributed to
     this library and every other costmap instance then fails to find them. -->
<class_libraries>
  <library path="terrain_costmap_layer">
    <class type="terrain_costmap_layer::TerrainLayer" base_class_type="nav2_costmap_2d::Layer">
      <description>
        Persistent graded terrain (slope) cost layer. Writes graded cost for
        gentle terrain and LETHAL for steep terrain / curb drop-offs, and
        accumulates over the rolling window so it persists as the robot moves.
      </description>
    </class>
  </library>
</class_libraries>
