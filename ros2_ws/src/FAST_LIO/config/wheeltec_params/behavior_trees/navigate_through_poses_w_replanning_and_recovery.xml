
<!--
  This Behavior Tree keeps the global path until it expires, the goal changes, or the
  path gets blocked, rather than replanning unconditionally. An unconditional replan
  flip-flops between the two sides of a symmetric obstacle (pillar) and the robot
  oscillates left/right following it.

  goal_checker_id must be spelled out: controller_server only falls back to an
  unnamed checker while exactly one is configured, and the outdoor stack also
  loads precise_goal_checker for the campus_nav route end.

  SHARED BY BOTH STACKS. Both launch files rewrite default_nav_*_bt_xml to point
  here, against param files that tune the same knobs very differently:
    indoor   yhs_nav2.launch.py:42-43      + config/param_yhs.yaml
    outdoor  outdoor_nav2.launch.py:32-33  + config/param_outdoor_elevation.yaml
  So recovery tuning in this file lands on the indoor slam stack too. campus_nav's
  route end is the exception: it passes its own tree by absolute path
  (campus_nav/config/behavior_trees/navigate_to_pose_precise_goal.xml, outdoor only).
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="5" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="2.0">
          <RecoveryNode number_of_retries="1" name="ComputePathThroughPoses">
            <Fallback>
              <ReactiveSequence>
                <Inverter>
                  <PathExpiringTimer seconds="3" path="{path}"/>
                </Inverter>
                <Inverter>
                  <GlobalUpdatedGoal/>
                </Inverter>
                <IsPathValid path="{path}"/>
              </ReactiveSequence>
              <ReactiveSequence>
                <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="2.0"/>
                <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
              </ReactiveSequence>
            </Fallback>
            <Sequence name="ClearGlobalThenSettle">
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
              <Wait wait_duration="2"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="general_goal_checker"/>

          <Sequence name="ClearLocalThenSettle">
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
            <Wait wait_duration="2"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            <Wait wait_duration="3"/>
          </Sequence>
          <Wait wait_duration="5"/>
          <!-- <BackUp backup_dist="0.30" backup_speed="0.1" time_allowance="15"/> -->
          <!-- <Spin spin_dist="0.785" time_allowance="18"/> -->
          <!-- <Spin spin_dist="-0.785" time_allowance="18"/> -->
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>

