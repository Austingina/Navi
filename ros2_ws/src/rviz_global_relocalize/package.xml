<?xml version="1.0"?>
<package format="3">
  <name>rviz_global_relocalize</name>
  <version>0.1.0</version>
  <description>RViz2 tool to trigger /global_relocalize service by clicking in the view</description>
  <maintainer email="devnull@example.com">dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_srvs</depend>
  <depend>rviz_common</depend>
  <depend>rviz_rendering</depend>
  <depend>pluginlib</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <build_export_depend>ament_index_cpp</build_export_depend>
  <exec_depend>ros2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
