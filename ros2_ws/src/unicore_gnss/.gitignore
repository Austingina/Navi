# ── 编译产物 ────────────────────────────────────────────────
# Edge SDK 示例是手工 make 的，不走 colcon，产物落在源码目录里。
*.o
*.d

# 可执行文件（无扩展名，只能逐个列）：demo 是我们的最小示例，
# edge_app 是 SDK 原示例的产物（源码已删，防止旧产物残留入库）。
Edge_SDK_*/example/demo
Edge_SDK_*/example/edge_app

# 注意：*.a 不要忽略 —— library/libtpservice.a 是厂商静态库，需要入库。

# ── 缓存 ────────────────────────────────────────────────────
__pycache__/
.pytest_cache/

# ── 凭据 ────────────────────────────────────────────────────
# tpservice.conf 仅作模板（account=xxx）；填了真实账号密码的副本
# 命名为 *.local.conf，用 demo -c 指定，避免误提交。
*.local.conf
